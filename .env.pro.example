# ============================================================================================
# PROFIL PRO - DONNÉES RÉELLES.  cp .env.pro.example .env   (le fichier .env n'est JAMAIS commité)
# Toute variable marquée OBLIGATOIRE sans valeur fait échouer le démarrage ; ProductionGuard refuse en plus
# les valeurs faibles ou d'exemple. Générer les secrets : openssl rand -base64 36
# ============================================================================================

# ---- Application -------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=pro,json
VAS_PUBLIC_BASE_URL=http://app:8080          # OBLIGATOIRE - URL interne de l'application vue par Jasmin (DLR) ; jamais localhost
TOKEN_SECRET=                                # OBLIGATOIRE - >= 32 caractères, identique sur toutes les instances
CALLBACK_SECRET=                             # OBLIGATOIRE - >= 24 caractères ; même valeur injectée dans Jasmin (provision.sh)
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=                         # OBLIGATOIRE - {bcrypt}$2a$10$...   (htpasswd -bnBC 10 "" 'MotDePasse-Fort-123' | tr -d ':\n' puis préfixer {bcrypt})
PROMETHEUS_PASSWORD_HASH=                    # compte de scraping (rôle NOC), même format ; le mot de passe en clair va dans secrets/prometheus_password
OPERATORS_SYNC=create-only                   # create-only | overwrite (la configuration ci-dessous écrase la base)

# ---- PostgreSQL ---------------------------------------------------------------------------
DB_URL=jdbc:postgresql://postgres:5432/vas   # OBLIGATOIRE
DB_USER=vas
DB_PASSWORD=                                 # OBLIGATOIRE
POSTGRES_DB=vas

# ---- RabbitMQ / Redis -----------------------------------------------------------------------
RABBIT_HOST=rabbitmq
RABBIT_PORT=5672
RABBIT_USER=vas
RABBIT_PASSWORD=                             # OBLIGATOIRE
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                              # recommandé

# ---- Jasmin (passerelle SMPP) ---------------------------------------------------------------------
JASMIN_URL=http://jasmin:1401
JASMIN_PASSWORD=                             # OBLIGATOIRE - >= 12 caractères (utilisateurs Jasmin vas_<opérateur>)
JCLI_USER=jcliadmin
JCLI_PASSWORD=                               # mot de passe admin jcli (défaut de l'image à CHANGER)

# ---- Opérateurs : paramètres fournis par chaque opérateur (CDC Annexe B) ----------------------------------
# Pour chaque opérateur, renseigner TOUT le bloc. Un opérateur dont *_SMSC_HOST est vide n'est pas provisionné dans Jasmin.
# Métier (lu par l'application) :
TT_MSISDN_PREFIXES=                          # ex. "9,4" - source opérateur ; attention portabilité des numéros
TT_SHORT_CODES=                              # numéros courts attribués, séparés par des virgules
TT_TPS=50                                    # débit contractuel (SMS/s)
TT_DLR_BILLING_RULE=ON_DELIVERED             # ON_DELIVERED | ON_SUBMITTED selon le contrat
# SMPP (lu par infra/jasmin/provision.sh uniquement - jamais par l'application) :
TT_SMSC_HOST=
TT_SMSC_PORT=2775
TT_SYSTEM_ID=
TT_SMSC_PASSWORD=
TT_SYSTEM_TYPE=VAS
TT_BIND_MODE=transceiver                     # transceiver | transmitter | receiver
TT_SRC_TON=3
TT_SRC_NPI=0
TT_DST_TON=1
TT_DST_NPI=1
TT_ELINK=30                                  # enquire_link (secondes)

ORANGE_MSISDN_PREFIXES=
ORANGE_SHORT_CODES=
ORANGE_TPS=50
ORANGE_DLR_BILLING_RULE=ON_DELIVERED
ORANGE_SMSC_HOST=
ORANGE_SMSC_PORT=2775
ORANGE_SYSTEM_ID=
ORANGE_SMSC_PASSWORD=
ORANGE_SYSTEM_TYPE=VAS
ORANGE_BIND_MODE=transceiver
ORANGE_SRC_TON=3
ORANGE_SRC_NPI=0
ORANGE_DST_TON=1
ORANGE_DST_NPI=1
ORANGE_ELINK=30

OOREDOO_MSISDN_PREFIXES=
OOREDOO_SHORT_CODES=
OOREDOO_TPS=50
OOREDOO_DLR_BILLING_RULE=ON_DELIVERED
OOREDOO_SMSC_HOST=
OOREDOO_SMSC_PORT=2775
OOREDOO_SYSTEM_ID=
OOREDOO_SMSC_PASSWORD=
OOREDOO_SYSTEM_TYPE=VAS
OOREDOO_BIND_MODE=transceiver
OOREDOO_SRC_TON=3
OOREDOO_SRC_NPI=0
OOREDOO_DST_TON=1
OOREDOO_DST_NPI=1
OOREDOO_ELINK=30

# ---- Conservation des données (jours, 0 = pas de purge) - À ARRÊTER AVEC LE CONSEIL JURIDIQUE --------------
RETENTION_MESSAGES_DAYS=0
RETENTION_CONSENT_DAYS=0
RETENTION_AUDIT_DAYS=0
RETENTION_WEBHOOK_DAYS=90

# ---- Passerelle TLS (reverse proxy) ---------------------------------------------------------------------
PUBLIC_HOSTNAME=vas.example.tn               # nom DNS public ; certificats dans ./certs/fullchain.pem et ./certs/privkey.pem

# ---- Supervision / alertes (Alertmanager) -------------------------------------------------------------------
GRAFANA_PASSWORD=                            # OBLIGATOIRE
ALERT_EMAIL_TO=                              # destinataires séparés par des virgules
ALERT_EMAIL_FROM=alertes@example.tn
ALERT_SMTP_HOST=smtp.example.tn:587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_WEBHOOK_URL=                           # Teams / Slack (URL de webhook entrant), optionnel

# ---- Sauvegardes (infra/backup) -----------------------------------------------------------------------
BACKUP_DIR=/var/backups/vas
BACKUP_GPG_RECIPIENT=                        # empreinte/e-mail de la clé PUBLIQUE du client (la clé privée reste hors serveur)
OFFSITE_TARGET=                              # destination rsync hors site, optionnel
RETENTION_DAYS=30
