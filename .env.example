# ======================================================================================================================
# UN SEUL FICHIER DE CONFIGURATION : .env  (jamais commité - voir .gitignore)
#
#   1. ./tools/init-env.py          crée .env depuis ce modèle et GÉNÈRE tous les secrets internes (mots de passe, clés, hash admin)
#   2. éditer .env                  renseigner uniquement les valeurs « EXTERNES » (marquées [À RENSEIGNER]) : opérateurs, domaine, SMTP, ...
#   3. ./tools/check-env.py         contrôle complet (présence, format, cohérence, fichiers) AVANT le démarrage
#   4. docker compose up -d --build && docker compose run --rm jasmin-provision
#
# Toutes les variables lues par l'application, docker-compose, Jasmin, nginx, Prometheus, Alertmanager, les sauvegardes et les scripts sont ICI
# (un test automatisé, EnvContractTests, échoue si une variable utilisée ailleurs n'est pas déclarée dans ce fichier).
# [AUTO]  = généré par init-env.sh (ne pas inventer de valeur)      [À RENSEIGNER] = fourni par le client / les opérateurs
# Valeur entre apostrophes = littérale (obligatoire pour les hash bcrypt contenant des $).
# ======================================================================================================================

# ---- 1. Application et sécurité -----------------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=pro,json
VAS_PUBLIC_BASE_URL=http://app.vas.internal:8080   # URL INTERNE vue par Jasmin (DLR + MO) ; nom AVEC point (alias du compose) ; jamais localhost
TOKEN_SECRET=                                      # [AUTO] >= 32 car., identique sur toutes les instances
DATA_KEY=                                          # [AUTO] >= 32 car. : chiffre les numéros en base. SAUVEGARDER HORS SERVEUR (perte = numéros irrécupérables). Rotation : outil Rekey
CALLBACK_SECRET=                                   # [AUTO] >= 24 car. ; injecté aussi dans Jasmin par provision.sh
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=                               # [AUTO] hash bcrypt du premier SUPER_ADMIN (le mot de passe en clair est affiché UNE fois par init-env.sh)
PROMETHEUS_PASSWORD=                               # [AUTO] mot de passe de scraping de Prometheus
PROMETHEUS_PASSWORD_HASH=                          # [AUTO] hash bcrypt du compte de scraping (rôle NOC)
OPERATORS_SYNC=create-only                         # create-only | overwrite (la configuration ci-dessous écrase la base)
SESSION_TTL_MINUTES=30                             # durée d'une session du back-office (5 à 480)
PASSWORD_MIN_LENGTH=12                             # longueur minimale des mots de passe (jamais moins de 12)
AUTH_THROTTLE_PER_MINUTE=20                        # échecs d'authentification tolérés par minute et par adresse source
TZ=Africa/Tunis
JAVA_MAX_RAM_PERCENT=75
JAVA_OPTS=                                         # options JVM supplémentaires, optionnel
LOG_LEVEL=INFO                                     # niveau des journaux applicatifs (tn.vas)
LOG_LEVEL_ROOT=INFO

# ---- 2. Comportement de la messagerie ---------------------------------------------------------------------------------------------
MT_MAX_ATTEMPTS=5                                  # tentatives d'envoi d'un MT avant échec
MT_RETRY_BACKOFF_SECONDS=30
MO_DEDUP_SECONDS=30                                # fenêtre de dédoublonnage des MO identiques
DLR_TIMEOUT_HOURS=72                               # sans accusé de livraison : MT inconnu + facturation contestée
RATE_SAFETY_FACTOR=0.9                             # marge sous le débit contractuel (0.9 = 90 %)
SUBSCRIPTION_RENEWAL_DAYS=30
SUBSCRIPTION_RETRY_DAYS=1
SUBSCRIPTION_MAX_FAILURES=3                        # échecs consécutifs avant suspension de l'abonnement
SUBSCRIPTION_GUARD_DAYS=3
MT_CONSUMERS_TRANSACTIONAL=4-8                     # consommateurs RabbitMQ par priorité (min-max)
MT_CONSUMERS_CONFIRMATION=2-4
MT_CONSUMERS_BULK=1-2
RENEWAL_CRON=0 0 * * * *                           # planificateurs (cron Spring à 6 champs)
RETENTION_CRON=0 30 2 * * *
PROJECTION_RECONCILE_CRON=0 15 3 * * *

# ---- 3. PostgreSQL --------------------------------------------------------------------------------------------------------------------
DB_URL=jdbc:postgresql://postgres:5432/vas
DB_USER=vas
DB_PASSWORD=                                       # [AUTO]
POSTGRES_DB=vas
POSTGRES_MAX_CONNECTIONS=200
DB_POOL_MAX=30
DB_POOL_MIN=5
SERVER_MAX_THREADS=200
READ_DB_URL=                                       # optionnel (CQRS) : jdbc:postgresql://replica:5432/vas ; vide = lectures sur la base primaire
READ_DB_USER=                                      # défaut : DB_USER
READ_DB_PASSWORD=                                  # défaut : DB_PASSWORD

# ---- 4. RabbitMQ / Redis ----------------------------------------------------------------------------------------------------------------
RABBIT_HOST=rabbitmq
RABBIT_PORT=5672
RABBIT_USER=vas
RABBIT_PASSWORD=                                   # [AUTO]
RABBIT_SSL=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                                    # [AUTO] obligatoire (partagé avec Jasmin)

# ---- 5. Jasmin (passerelle SMPP) --------------------------------------------------------------------------------------------------------
JASMIN_URL=http://jasmin:1401
JASMIN_PASSWORD=                                   # [AUTO] 12 à 16 car. [A-Za-z0-9_-] (limite de Jasmin)
JCLI_USER=jcliadmin
JCLI_PASSWORD=                                     # [AUTO] mot de passe de la console d'administration jcli
JCLI_PASSWORD_MD5=                                 # [AUTO] md5 de JCLI_PASSWORD (exigé par Jasmin) ; contrôlé par check-env.py

# ---- 6. Opérateurs : un bloc par opérateur, fourni par chacun (Annexe B du cahier des charges) --------------------------------
# Un opérateur dont *_SMSC_HOST est vide n'est pas provisionné dans Jasmin. SMSC_HOST_2..4 : liaisons de secours (même compte SMPP).
# [À RENSEIGNER] Tunisie Telecom
TT_SMSC_HOST=
TT_SMSC_HOST_2=
TT_SMSC_HOST_3=
TT_SMSC_HOST_4=
TT_LINK_MODE=failover                              # failover | roundrobin
TT_SMSC_PORT=2775
TT_SYSTEM_ID=
TT_SMSC_PASSWORD=
TT_SYSTEM_TYPE=VAS
TT_BIND_MODE=transceiver                           # transceiver | transmitter | receiver
TT_SRC_TON=3
TT_SRC_NPI=0
TT_DST_TON=1
TT_DST_NPI=1
TT_ELINK=30                                        # enquire_link (secondes)
TT_MSISDN_PREFIXES=                                # ex. 9,4 (source opérateur ; la portabilité est traitée par ROUTING_PORTED_FILE)
TT_SHORT_CODES=                                    # numéros courts attribués, séparés par des virgules
TT_TPS=50                                          # débit contractuel (SMS/s)
TT_DLR_BILLING_RULE=ON_DELIVERED                   # ON_DELIVERED | ON_SUBMITTED selon le contrat
TT_RECON_SEPARATOR=;                               # relevé de facturation : séparateur CSV
TT_RECON_ID_COLUMN=event_id                        # nom (ou numéro, base 0) de la colonne « identifiant d'événement »
TT_RECON_AMOUNT_COLUMN=amount
TT_RECON_STATUS_COLUMN=status
TT_RECON_STATUS_MAP=                               # ex. PAYE=CHARGED;REFUSE=REJECTED (termes de l'opérateur -> statuts de la plateforme)
TT_RECON_AMOUNT_DIVISOR=1                          # 1000 si le relevé est exprimé en millimes

# [À RENSEIGNER] Orange Tunisie
ORANGE_SMSC_HOST=
ORANGE_SMSC_HOST_2=
ORANGE_SMSC_HOST_3=
ORANGE_SMSC_HOST_4=
ORANGE_LINK_MODE=failover
ORANGE_SMSC_PORT=2775
ORANGE_SYSTEM_ID=
ORANGE_SMSC_PASSWORD=
ORANGE_SYSTEM_TYPE=VAS
ORANGE_BIND_MODE=transceiver
ORANGE_SRC_TON=3
ORANGE_SRC_NPI=0
ORANGE_DST_TON=1
ORANGE_DST_NPI=1
ORANGE_ELINK=30
ORANGE_MSISDN_PREFIXES=
ORANGE_SHORT_CODES=
ORANGE_TPS=50
ORANGE_DLR_BILLING_RULE=ON_DELIVERED
ORANGE_RECON_SEPARATOR=;
ORANGE_RECON_ID_COLUMN=event_id
ORANGE_RECON_AMOUNT_COLUMN=amount
ORANGE_RECON_STATUS_COLUMN=status
ORANGE_RECON_STATUS_MAP=
ORANGE_RECON_AMOUNT_DIVISOR=1

# [À RENSEIGNER] Ooredoo Tunisie
OOREDOO_SMSC_HOST=
OOREDOO_SMSC_HOST_2=
OOREDOO_SMSC_HOST_3=
OOREDOO_SMSC_HOST_4=
OOREDOO_LINK_MODE=failover
OOREDOO_SMSC_PORT=2775
OOREDOO_SYSTEM_ID=
OOREDOO_SMSC_PASSWORD=
OOREDOO_SYSTEM_TYPE=VAS
OOREDOO_BIND_MODE=transceiver
OOREDOO_SRC_TON=3
OOREDOO_SRC_NPI=0
OOREDOO_DST_TON=1
OOREDOO_DST_NPI=1
OOREDOO_ELINK=30
OOREDOO_MSISDN_PREFIXES=
OOREDOO_SHORT_CODES=
OOREDOO_TPS=50
OOREDOO_DLR_BILLING_RULE=ON_DELIVERED
OOREDOO_RECON_SEPARATOR=;
OOREDOO_RECON_ID_COLUMN=event_id
OOREDOO_RECON_AMOUNT_COLUMN=amount
OOREDOO_RECON_STATUS_COLUMN=status
OOREDOO_RECON_STATUS_MAP=
OOREDOO_RECON_AMOUNT_DIVISOR=1

# ---- 7. Données de démarrage (fichiers déposés dans ./data, montés en /data dans l'application) -------------------------------
# Modèles : data/ranges.example.csv, data/ported.example.csv, data/catalog.example.json. Vide = rien n'est chargé.
ROUTING_RANGES_FILE=                               # [À RENSEIGNER] ex. /data/ranges.csv   (« préfixe;opérateur », données officielles)
ROUTING_PORTED_FILE=                               # [À RENSEIGNER] ex. /data/ported.csv   (« numéro;opérateur », portabilité)
CATALOG_FILE=                                      # [À RENSEIGNER] ex. /data/catalog.json (partenaires, services, mots-clés, tarifs ; services en brouillon, tarifs à approuver à 4 yeux)

# ---- 8. Conservation des données (jours, 0 = pas de purge) : À ARRÊTER AVEC LE CONSEIL JURIDIQUE ------------------------------
RETENTION_MESSAGES_DAYS=0
RETENTION_CONSENT_DAYS=0
RETENTION_AUDIT_DAYS=0
RETENTION_WEBHOOK_DAYS=90

# ---- 9. Webhooks partenaires --------------------------------------------------------------------------------------------------------------
WEBHOOK_ALLOWED_HOSTS=                             # optionnel : hôtes autorisés (virgules) ; sinon https + adresses publiques uniquement

# ---- 10. Passerelle TLS (reverse proxy) -------------------------------------------------------------------------------------------------
PUBLIC_HOSTNAME=vas.example.tn                     # [À RENSEIGNER] nom DNS public ; certificats dans ./certs/fullchain.pem et ./certs/privkey.pem
HTTP_PORT=80
HTTPS_PORT=443
ADMIN_ALLOWED_CIDRS=                               # [À RENSEIGNER] réseaux autorisés vers /admin/ (VPN d'administration), ex. 10.8.0.0/24,192.0.2.10 ; vide = pas de restriction
PROXY_API_RATE=30                                  # requêtes/seconde/adresse
PROXY_LOGIN_RATE=5                                 # connexions/minute/adresse

# ---- 11. Supervision et alertes -------------------------------------------------------------------------------------------------------------
GRAFANA_PASSWORD=                                  # [AUTO]
GRAFANA_BIND=127.0.0.1                             # 0.0.0.0 pour exposer Grafana (déconseillé hors VPN)
ALERT_EMAIL_TO=                                    # [À RENSEIGNER] destinataires, séparés par des virgules
ALERT_EMAIL_FROM=alertes@example.tn
ALERT_SMTP_HOST=smtp.example.tn:587                # [À RENSEIGNER]
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_WEBHOOK_URL=                                 # [À RENSEIGNER] Teams / Slack (webhook entrant), optionnel

# ---- 12. Sauvegardes (infra/backup, lues dans ce même fichier) ---------------------------------------------------------------------
BACKUP_DIR=/var/backups/vas
BACKUP_GPG_RECIPIENT=                              # [À RENSEIGNER] empreinte / e-mail de la clé PUBLIQUE du client (la clé privée reste hors serveur)
BACKUP_RETENTION_DAYS=30
OFFSITE_TARGET=                                    # [À RENSEIGNER] destination rsync hors site, ex. sauvegarde@hote:/srv/vas ; optionnel

# ---- 13. Haute disponibilité (uniquement avec infra/ha/docker-compose.ha.yml) --------------------------------------------------------
DB_SUPERUSER_PASSWORD=                             # [AUTO]
DB_REPLICATION_PASSWORD=                           # [AUTO]
RABBIT_COOKIE=                                     # [AUTO] cookie Erlang commun aux 3 nœuds RabbitMQ
